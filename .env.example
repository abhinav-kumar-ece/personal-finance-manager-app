# GEMINI_API_KEY: Required for Gemini AI API calls.
# Move to Google Cloud Secret Manager for Cloud Run deployments.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client configuration (for multi-user Auth and Firestore sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server runtime port (Cloud Run sets PORT=8080 automatically)
PORT=3000

# Security: Set to 'true' ONLY for offline local mock auth testing. NEVER set in production.
ALLOW_MOCK_AUTH=
